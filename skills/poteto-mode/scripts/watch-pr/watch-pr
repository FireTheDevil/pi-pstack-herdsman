#!/usr/bin/env bun
import { assertDependenciesInstalled } from "../bootstrap.ts";

const argv = process.argv.slice(2);
const boundedOption = "--stop-at-frontier-ready";
let afterSeparator = false;
for (const argument of argv) {
  if (argument === "--") {
    afterSeparator = true;
    continue;
  }
  const equals = argument.indexOf("=");
  const name = equals < 0 ? argument : argument.slice(0, equals);
  if (
    name.startsWith("--") && name.length > 2 &&
    (boundedOption.startsWith(name) || name.startsWith(boundedOption))
  ) {
    if (afterSeparator || argument !== boundedOption) {
      process.stderr.write(`error: use ${boundedOption} exactly, without a value or abbreviation, and before --\n`);
      process.exit(64);
    }
  }
}
assertDependenciesInstalled();
const { main } = await import("./cli.ts");
process.exitCode = await main(argv);
